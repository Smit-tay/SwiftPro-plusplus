#
# Writes the build stamp header (R-18). Run on every build by the build_info target in CMakeLists.txt:
#   cmake -DOUT=<build_stamp.h> -DSRC=<source dir> [-DFIXED=<text>] -P build_info.cmake
#
# The stamp is one token, so P2210 replies like every other "ok V..." query:
#   SPP-20261102T143012Z-cf72a17          built from commit cf72a17, nothing uncommitted
#   SPP-20261102T143012Z-cf72a17-dirty    built with uncommitted changes in the tree
#   SPP-20261102T143012Z-nogit            built outside a git checkout (e.g. from an archive)
#   SPP-<FIXED>                           fixed text, used by the host build so the golden traces stay stable
#
# Time is UTC (no daylight-saving ambiguity). The header is rewritten only when the text changes; since the time
# changes on every build, build_info.cpp is recompiled on every build and nothing else is.

if(DEFINED FIXED AND NOT FIXED STREQUAL "")
    set(stamp "SPP-${FIXED}")
else()
    string(TIMESTAMP when "%Y%m%dT%H%M%SZ" UTC)
    set(rev "nogit")
    find_program(GIT_EXE git)
    if(GIT_EXE)
        execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse --short=7 HEAD
                        OUTPUT_VARIABLE head RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(rc EQUAL 0)
            set(rev "${head}")
            # Ignored files (build/, logs) don't count; anything else uncommitted, including new files, does.
            execute_process(COMMAND ${GIT_EXE} -C ${SRC} status --porcelain
                            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(NOT changes STREQUAL "")
                string(APPEND rev "-dirty")
            endif()
        endif()
    endif()
    set(stamp "SPP-${when}-${rev}")
endif()

set(content "// Generated by cmake/build_info.cmake on every build. Do not edit; not in git.\n#pragma once\n#define SPP_BUILD_STAMP \"${stamp}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
message(STATUS "Build stamp: ${stamp}")
